# Configurações de Ambiente — Exemplo de Produção / Desenvolvimento
# Renomeie este arquivo para .env e preencha as variáveis correspondentes.

# URL principal do site (usada para metatags SEO/Open Graph)
VITE_SITE_URL=https://seu-dominio-portfolio.com.br

# URLs do CMS (WordPress)
VITE_WORDPRESS_GRAPHQL_URL=https://seu-wordpress.com/graphql
VITE_CMS_API_URL=https://seu-wordpress.com/wp-json

# Informações de Contato (WhatsApp e Redes Sociais)
VITE_WHATSAPP_PHONE=5571999999999
VITE_WHATSAPP_MESSAGE=Olá! Vi o site e gostaria de obter mais informações sobre a aceleração.
VITE_WHATSAPP_GROUP=https://chat.whatsapp.com/exemplo-grupo
VITE_INSTAGRAM_URL=https://www.instagram.com/seu-perfil

# Informações de E-mail e Telefone Exibidos na Interface
VITE_EMAIL_CONTACT=contato@sua-aceleradora.com.br
VITE_CONTACT_PHONE_LABEL=(71) 99999-9999
